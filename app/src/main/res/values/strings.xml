    <string name="consent_service_title">Utilisation du service</string>
    <string name="consent_service_text">Ce consentement permet de créer votre compte et d\'utiliser CHIFAA : le compagnon, la bibliothèque de fiches et l\'annuaire. Vous êtes identifiée par un pseudonyme ; votre numéro est chiffré et sert uniquement à la connexion.</string>
    <string name="consent_service_data">Pseudonyme, tranche d\'âge, gouvernorat, langue, numéro de téléphone chiffré, historique des conversations.</string>

    <string name="consent_health_title">Données de santé</string>
    <string name="consent_health_text">Ce consentement ouvre votre « Espace santé » : votre parcours de soins, vos bilans et vos effets ressentis. Ces informations restent séparées de votre identité. Sans ce consentement, l\'Espace santé reste masqué.</string>
    <string name="consent_health_data">Type de cancer, étape du parcours, traitements, effets secondaires déclarés, intérêt pour la fertilité.</string>

    <string name="consent_survey_title">Enquête de satisfaction</string>
    <string name="consent_survey_text">Ce consentement vous permet de répondre à un court questionnaire pour aider l\'équipe CHIFAA à améliorer l\'application. Vos réponses sont analysées uniquement de façon groupée.</string>
    <string name="consent_survey_data">Besoins non couverts, sources de soutien, note de satisfaction, commentaire libre.</string>

    <string name="consent_service_refused_title">Consentement nécessaire</string>
