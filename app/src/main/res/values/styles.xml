<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===== Boutons ===== -->
    <!-- Bouton principal (plein) -->
    <style name="Widget.Chifaa.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">@dimen/radius_m</item>
        <item name="backgroundTint">@color/brand_raspberry</item>
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
        <item name="iconPadding">10dp</item>
    </style>

    <!-- Bouton secondaire (contour) -->
    <style name="Widget.Chifaa.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">@dimen/radius_m</item>
        <item name="strokeColor">@color/brand_raspberry</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/brand_raspberry</item>
        <item name="iconTint">@color/brand_raspberry</item>
        <item name="iconPadding">10dp</item>
    </style>

    <!-- Bouton texte (action discrète) -->
    <style name="Widget.Chifaa.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/brand_plum</item>
        <item name="iconTint">@color/brand_plum</item>
        <item name="iconPadding">8dp</item>
    </style>

    <!-- ===== Champs de saisie ===== -->
    <style name="Widget.Chifaa.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/selector_box_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="hintTextColor">@color/brand_raspberry</item>
        <item name="startIconTint">@color/text_secondary</item>
        <item name="errorIconDrawable">@null</item>
        <item name="helperTextTextColor">@color/text_secondary</item>
    </style>

    <!-- Liste déroulante (choix dans une liste fermée) -->
    <style name="Widget.Chifaa.TextInput.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/selector_box_stroke</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="hintTextColor">@color/brand_raspberry</item>
        <item name="startIconTint">@color/text_secondary</item>
        <item name="helperTextTextColor">@color/text_secondary</item>
    </style>

    <!-- Carte de choix (sélectionnable) -->
    <style name="Widget.Chifaa.ChoiceCard" parent="Widget.Material3.CardView.Outlined">
        <item name="android:checkable">true</item>
        <item name="cardCornerRadius">@dimen/radius_m</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/selector_card_stroke</item>
        <item name="strokeWidth">2dp</item>
        <item name="checkedIconTint">@color/brand_raspberry</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- ===== Sections (écran profil, réglages) ===== -->
    <style name="Chifaa.SectionTitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/space_s</item>
        <item name="android:layout_marginTop">@dimen/space_l</item>
        <item name="android:layout_marginBottom">@dimen/space_s</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/brand_raspberry</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Chifaa.SectionCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Message d'erreur sous un groupe de choix (masqué par défaut) -->
    <style name="Chifaa.ErrorText" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_xs</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/state_error</item>
        <item name="android:visibility">gone</item>
        <item name="android:accessibilityLiveRegion">polite</item>
    </style>

    <!-- ===== Cartes ===== -->
    <!-- Carte "feuille" arrondie seulement en haut -->
    <style name="ShapeAppearance.Chifaa.TopSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/radius_l</item>
        <item name="cornerSizeTopRight">@dimen/radius_l</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- ===== Typographie ===== -->
    <style name="TextAppearance.Chifaa.Display" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Chifaa.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Chifaa.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Chifaa.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Chifaa.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

</resources>
