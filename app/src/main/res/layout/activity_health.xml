<?xml version="1.0" encoding="utf-8"?>
<!-- Espace santé (module M3) : parcours, bilans + graphique, fertilité. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:orientation="vertical"
    tools:context=".activities.HealthActivity">

    <include layout="@layout/layout_step_header" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_m">

            <!-- ===================== MON PARCOURS ===================== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Chifaa.SectionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_m">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_tile">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_health"
                                app:tint="@color/brand_raspberry" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/health_journey_title"
                            android:textAppearance="@style/TextAppearance.Chifaa.Title" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnJourney"
                            style="@style/Widget.Chifaa.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:onClick="ouvrirParcours"
                            android:text="@string/health_journey_fill"
                            android:textColor="@color/brand_raspberry"
                            app:icon="@drawable/ic_edit"
                            app:iconTint="@color/brand_raspberry" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvJourneyEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/health_journey_empty"
                        android:textAppearance="@style/TextAppearance.Chifaa.Body" />

                    <!-- Résumé du parcours (rempli en Java) -->
                    <LinearLayout
                        android:id="@+id/journeySummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvJourneyUpdated"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:textAppearance="@style/TextAppearance.Chifaa.Caption"
                        android:textColor="@color/text_hint"
                        android:textSize="12sp"
                        android:visibility="gone"
                        tools:text="Mis à jour le 25 novembre 2026" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===================== MES BILANS ===================== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Chifaa.SectionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_m">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_tile">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_poll"
                                app:tint="@color/brand_raspberry" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/health_checkins_title"
                            android:textAppearance="@style/TextAppearance.Chifaa.Title" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvCheckinsEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/health_checkins_empty"
                        android:textAppearance="@style/TextAppearance.Chifaa.Body" />

                    <!-- Graphique simple -->
                    <LinearLayout
                        android:id="@+id/chartContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/health_chart_caption"
                            android:textAppearance="@style/TextAppearance.Chifaa.Caption" />

                        <com.example.chifaa.views.SideEffectsChartView
                            android:id="@+id/chart"
                            android:layout_width="match_parent"
                            android:layout_height="170dp"
                            android:layout_marginTop="@dimen/space_s"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp" />
                    </LinearLayout>

                    <!-- Historique -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvCheckins"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:nestedScrollingEnabled="false" />

                    <TextView
                        android:id="@+id/tvDeleteHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/health_delete_hint"
                        android:textAppearance="@style/TextAppearance.Chifaa.Caption"
                        android:textColor="@color/text_hint"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.Chifaa.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:onClick="nouveauBilan"
                        android:text="@string/health_new_checkin"
                        app:icon="@drawable/ic_add"
                        app:iconGravity="textStart" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===================== FERTILITÉ ===================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFertility"
                style="@style/Chifaa.SectionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_m">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_tile">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_favorite"
                                app:tint="@color/brand_raspberry" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/health_fertility_title"
                            android:textAppearance="@style/TextAppearance.Chifaa.Title" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvFertility"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textAppearance="@style/TextAppearance.Chifaa.Body"
                        tools:text="@string/health_fertility_yes" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFertility"
                        style="@style/Widget.Chifaa.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:onClick="ouvrirFichesFertilite"
                        android:text="@string/health_fertility_open"
                        app:icon="@drawable/ic_book"
                        app:iconGravity="textStart" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Rappel de sécurité -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:background="@drawable/bg_info_box"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_info"
                    app:tint="@color/brand_raspberry" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/health_emergency"
                    android:textAppearance="@style/TextAppearance.Chifaa.Caption"
                    android:textColor="@color/brand_plum" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
