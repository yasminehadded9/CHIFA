<?xml version="1.0" encoding="utf-8"?>
<!-- Mon profil (module M2) : informations modifiables, langue de l'interface, déconnexion. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:orientation="vertical"
    tools:context=".activities.ProfileActivity">

    <include layout="@layout/layout_step_header" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_m">

            <!-- ===================== IDENTITÉ ===================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_s">

                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_hero_circle">

                    <TextView
                        android:id="@+id/tvProfileInitial"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:textColor="@color/white"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        tools:text="A" />

                    <ImageView
                        android:id="@+id/ivProfileRibbon"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_ribbon"
                        android:visibility="gone"
                        app:tint="@color/white" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvProfileName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Chifaa.Title"
                        android:textSize="20sp"
                        tools:text="Amira" />

                    <TextView
                        android:id="@+id/tvMemberSince"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.Chifaa.Caption"
                        tools:text="Membre depuis le 25 novembre 2026" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===================== MES INFORMATIONS ===================== -->
            <TextView
                style="@style/Chifaa.SectionTitle"
                android:text="@string/profile_section_info" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Chifaa.SectionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_m">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilDisplayName"
                        style="@style/Widget.Chifaa.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/field_display_name"
                        app:counterEnabled="true"
                        app:counterMaxLength="30"
                        app:helperText="@string/helper_display_name"
                        app:startIconDrawable="@drawable/ic_person">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDisplayName"
                            android:saveEnabled="false"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="textPersonName|textCapWords"
                            android:maxLength="30" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilAgeBand"
                        style="@style/Widget.Chifaa.TextInput.Dropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/field_age_band"
                        app:startIconDrawable="@drawable/ic_cake">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/acAgeBand"
                            android:saveEnabled="false"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            app:simpleItems="@array/age_bands" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilGovernorate"
                        style="@style/Widget.Chifaa.TextInput.Dropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/field_governorate"
                        app:startIconDrawable="@drawable/ic_place">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/acGovernorate"
                            android:saveEnabled="false"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            app:simpleItems="@array/governorates" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilLanguage"
                        style="@style/Widget.Chifaa.TextInput.Dropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/field_language"
                        app:helperText="@string/helper_language"
                        app:startIconDrawable="@drawable/ic_chat">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/acLanguage"
                            android:saveEnabled="false"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            app:simpleItems="@array/languages" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:text="@string/required_legend"
                        android:textAppearance="@style/TextAppearance.Chifaa.Caption" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSave"
                        style="@style/Widget.Chifaa.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:enabled="false"
                        android:onClick="enregistrer"
                        android:text="@string/profile_save"
                        app:icon="@drawable/ic_check_circle"
                        app:iconGravity="textStart" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===================== LANGUE DE L'INTERFACE ===================== -->
            <TextView
                style="@style/Chifaa.SectionTitle"
                android:text="@string/profile_section_app_language" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Chifaa.SectionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_m">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_translate"
                            app:tint="@color/brand_plum" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/profile_app_language_text"
                            android:textAppearance="@style/TextAppearance.Chifaa.Caption" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleAppLanguage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLangFr"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="@dimen/touch_min"
                            android:text="@string/lang_french"
                            android:textAllCaps="false" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLangAr"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="@dimen/touch_min"
                            android:text="@string/lang_arabic"
                            android:textAllCaps="false" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===================== CONFIDENTIALITÉ ===================== -->
            <TextView
                style="@style/Chifaa.SectionTitle"
                android:text="@string/profile_section_privacy" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Chifaa.SectionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Ligne cliquable : Mes données -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:minHeight="56dp"
                        android:onClick="ouvrirMesDonnees"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_m"
                        android:paddingEnd="@dimen/space_m">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_lock"
                            app:tint="@color/brand_teal" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/profile_my_data"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/text_hint" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_m">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_pid_label"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPid"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:background="@drawable/bg_pid_box"
                            android:fontFamily="monospace"
                            android:padding="10dp"
                            android:textColor="@color/brand_plum"
                            android:textDirection="ltr"
                            android:textIsSelectable="true"
                            android:textSize="12sp"
                            tools:text="3f2a9c1e-7b4d-4e2a-9f10-6c8b2d1e5a77" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:text="@string/home_pid_hint"
                            android:textAppearance="@style/TextAppearance.Chifaa.Caption" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===================== DÉCONNEXION ===================== -->
            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Chifaa.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:layout_marginBottom="@dimen/space_m"
                android:onClick="seDeconnecter"
                android:text="@string/home_logout"
                android:textColor="@color/state_error"
                app:icon="@drawable/ic_logout"
                app:iconGravity="textStart"
                app:iconTint="@color/state_error"
                app:strokeColor="@color/state_error" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
