<?xml version="1.0" encoding="utf-8"?>
<!-- Fiche d'un service : nom, adresse, téléphone, langues, coût, dernière vérification. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:orientation="vertical"
    tools:context=".activities.OrgDetailActivity">

    <include layout="@layout/layout_step_header" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_m">

            <!-- En-tête du service -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_s">

                <FrameLayout
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/brand_teal_soft">

                    <ImageView
                        android:id="@+id/ivType"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        app:tint="@color/brand_teal"
                        tools:src="@drawable/ic_health" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/brand_teal"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="Oncologie" />

                    <TextView
                        android:id="@+id/tvName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.Chifaa.Headline"
                        android:textSize="21sp"
                        tools:text="Service d'oncologie – Hôpital de démonstration" />
                </LinearLayout>
            </LinearLayout>

            <!-- Alerte : vérification de plus de 12 mois -->
            <LinearLayout
                android:id="@+id/outdatedWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:background="@drawable/bg_warning_box"
                android:orientation="horizontal"
                android:padding="12dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_warning"
                    app:tint="@color/state_warning" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/org_outdated_warning"
                    android:textColor="@color/state_warning"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Informations (lignes remplies en Java) -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Chifaa.SectionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m">

                <LinearLayout
                    android:id="@+id/infoRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/space_m"
                    android:paddingTop="@dimen/space_s"
                    android:paddingEnd="@dimen/space_m"
                    android:paddingBottom="@dimen/space_s" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Hors ligne -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_m"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_offline"
                    app:tint="@color/brand_teal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/org_offline"
                    android:textAppearance="@style/TextAppearance.Chifaa.Caption"
                    android:textColor="@color/brand_teal" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Actions : appel direct (ACTION_DIAL) et itinéraire (geo:) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/space_l">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDirections"
            style="@style/Widget.Chifaa.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:onClick="itineraire"
            android:text="@string/org_directions"
            app:icon="@drawable/ic_directions"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCall"
            style="@style/Widget.Chifaa.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:onClick="appeler"
            android:text="@string/directory_call"
            app:icon="@drawable/ic_phone"
            app:iconGravity="textStart" />
    </LinearLayout>
</LinearLayout>
