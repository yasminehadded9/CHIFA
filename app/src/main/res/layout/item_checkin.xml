<?xml version="1.0" encoding="utf-8"?>
<!-- Une ligne de l'historique des bilans (CheckinAdapter). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Pastille : nombre d'effets -->
    <TextView
        android:id="@+id/tvCount"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/brand_rose_soft"
        android:gravity="center"
        android:textColor="@color/brand_raspberry"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="3" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="25 nov. 2026" />

        <TextView
            android:id="@+id/tvEffects"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Chifaa.Caption"
            tools:text="Fatigue · Nausées · Anxiété" />
    </LinearLayout>
</LinearLayout>
