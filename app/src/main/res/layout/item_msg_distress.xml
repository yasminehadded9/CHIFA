<?xml version="1.0" encoding="utf-8"?>
<!-- Ressources d'aide affichées IMMÉDIATEMENT en cas de détresse détectée. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_distress_card"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_favorite"
            app:tint="@color/brand_teal" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:id="@+id/tvDistressTitle"
            android:text="@string/chat_distress_title"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="3dp"
        android:id="@+id/tvDistressText"
        android:text="@string/chat_distress_text"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

    <!-- Ressources fournies par l'équipe CHIFAA (aucun numéro inventé) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:drawablePadding="8dp"
        android:id="@+id/tvDistressResource"
        android:text="@string/chat_distress_resource"
        android:textColor="@color/brand_plum"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:id="@+id/tvDistressEmergency"
        android:text="@string/chat_distress_emergency"
        android:textColor="@color/brand_plum"
        android:textSize="14sp"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSupport"
        style="@style/Widget.Chifaa.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/chat_distress_services"
        app:backgroundTint="@color/brand_teal"
        app:icon="@drawable/ic_place"
        app:iconGravity="textStart" />
</LinearLayout>
