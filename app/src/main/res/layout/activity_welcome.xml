<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true"
    tools:context=".activities.WelcomeActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===================== EN-TÊTE ===================== -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero"
            android:clipChildren="true">

            <!-- Formes décoratives -->
            <View
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_deco_circle"
                android:translationX="90dp"
                android:translationY="-70dp" />

            <View
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_gravity="bottom|start"
                android:background="@drawable/bg_deco_circle"
                android:translationX="-50dp"
                android:translationY="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_l"
                android:paddingTop="56dp"
                android:paddingEnd="@dimen/space_l"
                android:paddingBottom="72dp">

                <FrameLayout
                    android:layout_width="92dp"
                    android:layout_height="92dp"
                    android:background="@drawable/bg_logo_circle">

                    <ImageView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/cd_logo"
                        android:src="@drawable/ic_ribbon"
                        app:tint="@color/white" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:gravity="center"
                    android:text="@string/welcome_title"
                    android:textAppearance="@style/TextAppearance.Chifaa.Display"
                    android:textColor="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:gravity="center"
                    android:maxWidth="320dp"
                    android:text="@string/welcome_subtitle"
                    android:textAppearance="@style/TextAppearance.Chifaa.Body"
                    android:textColor="@color/text_on_brand_soft"
                    android:textSize="16sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- ===================== CARTE D'ACTIONS ===================== -->
        <!-- Marge négative : la carte "remonte" sur l'en-tête (effet feuille). -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="-32dp"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/surface"
            app:cardElevation="0dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Chifaa.TopSheet"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome_card_title"
                    android:textAppearance="@style/TextAppearance.Chifaa.Headline" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="@string/welcome_card_text"
                    android:textAppearance="@style/TextAppearance.Chifaa.Body" />

                <!-- Action principale -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCreateAccount"
                    style="@style/Widget.Chifaa.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:onClick="creerCompte"
                    android:text="@string/welcome_create_account"
                    app:icon="@drawable/ic_person_add"
                    app:iconGravity="textStart" />

                <!-- Action secondaire -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogin"
                    style="@style/Widget.Chifaa.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:onClick="seConnecter"
                    android:text="@string/welcome_login"
                    app:icon="@drawable/ic_login"
                    app:iconGravity="textStart" />

                <!-- Séparateur "ou" -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/divider" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/welcome_or"
                        android:textAppearance="@style/TextAppearance.Chifaa.Caption" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/divider" />
                </LinearLayout>

                <!-- Accès équipe (back-office) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStaff"
                    style="@style/Widget.Chifaa.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/space_xs"
                    android:onClick="espaceEquipe"
                    android:text="@string/welcome_staff"
                    app:icon="@drawable/ic_shield" />

                <!-- Avertissement médical (exigence éthique du cahier des charges) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:background="@drawable/bg_info_box"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="1dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_info"
                        app:tint="@color/brand_raspberry" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/welcome_disclaimer"
                        android:textAppearance="@style/TextAppearance.Chifaa.Caption"
                        android:textColor="@color/brand_plum" />
                </LinearLayout>

                <!-- Mention confidentialité -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/space_m"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_lock"
                        app:tint="@color/brand_teal" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/welcome_privacy"
                        android:textAppearance="@style/TextAppearance.Chifaa.Caption"
                        android:textColor="@color/brand_teal" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
