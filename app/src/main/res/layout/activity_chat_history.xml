<?xml version="1.0" encoding="utf-8"?>
<!-- Historique des conversations. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:orientation="vertical"
    tools:context=".activities.ChatHistoryActivity">

    <include layout="@layout/layout_step_header" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSessions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="@dimen/space_m" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/chat_history_empty"
            android:textAppearance="@style/TextAppearance.Chifaa.Body"
            android:visibility="gone" />
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        style="@style/Widget.Chifaa.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_l"
        android:onClick="nouvelleConversation"
        android:text="@string/chat_history_new"
        app:icon="@drawable/ic_add"
        app:iconGravity="textStart" />
</LinearLayout>
