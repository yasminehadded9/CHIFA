<?xml version="1.0" encoding="utf-8"?>
<!-- Une page de l'onboarding (utilisée par OnboardingAdapter). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_xl"
        android:paddingTop="@dimen/space_m"
        android:paddingEnd="@dimen/space_xl"
        android:paddingBottom="@dimen/space_m">

        <!-- Illustration : deux cercles concentriques + icône -->
        <FrameLayout
            android:layout_width="230dp"
            android:layout_height="230dp">

            <View
                android:id="@+id/circleOuter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_circle" />

            <View
                android:id="@+id/circleInner"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle" />

            <ImageView
                android:id="@+id/ivIcon"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                tools:src="@drawable/ic_chat" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Chifaa.Headline"
            tools:text="@string/onb_title_1" />

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Chifaa.Body"
            android:textSize="16sp"
            tools:text="@string/onb_desc_1" />
    </LinearLayout>
</ScrollView>
