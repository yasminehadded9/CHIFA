<?xml version="1.0" encoding="utf-8"?>
<!-- Carte d'une fiche dans la liste (KbAdapter). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTopic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_required"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:textColor="@color/brand_raspberry"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Effets secondaires" />

            <TextView
                android:id="@+id/tvLanguage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:textAppearance="@style/TextAppearance.Chifaa.Caption"
                android:textSize="12sp"
                tools:text="Français" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/ivViewed"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/library_viewed"
                android:src="@drawable/ic_offline"
                android:visibility="gone"
                app:tint="@color/brand_teal" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textAppearance="@style/TextAppearance.Chifaa.Title"
            android:textSize="16sp"
            tools:text="Fatigue : mieux la comprendre" />

        <TextView
            android:id="@+id/tvExcerpt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.Chifaa.Caption"
            tools:text="La fatigue est l'un des effets les plus fréquents pendant et après les traitements..." />

        <TextView
            android:id="@+id/tvEvidence"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/brand_teal"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Preuve : Élevé" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
