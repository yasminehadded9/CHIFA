<?xml version="1.0" encoding="utf-8"?>
<!-- Nouveau bilan (M3) : date + effets secondaires ressentis (cases à cocher). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:orientation="vertical"
    tools:context=".activities.CheckinActivity">

    <include layout="@layout/layout_step_header" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_l">

            <!-- Date (ouverture d'un calendrier, pas de saisie au clavier) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDate"
                style="@style/Widget.Chifaa.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/field_checkin_date"
                app:helperText="@string/helper_checkin_date"
                app:startIconDrawable="@drawable/ic_calendar">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:inputType="none"
                    android:onClick="choisirDate" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/checkin_effects_label"
                android:textAppearance="@style/TextAppearance.Chifaa.Title"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/checkin_effects_hint"
                android:textAppearance="@style/TextAppearance.Chifaa.Caption" />

            <!-- Les 11 effets (puces à cocher, créées en Java) -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipsEffects"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s" />

            <!-- Choix exclusif "aucun effet" -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chipNoEffect"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/health_no_effect"
                app:chipBackgroundColor="@color/selector_chip_success"
                app:chipStrokeColor="@color/brand_teal" />

            <TextView
                android:id="@+id/tvEffectsError"
                style="@style/Chifaa.ErrorText" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:background="@drawable/bg_info_box"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_info"
                    app:tint="@color/brand_raspberry" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/health_emergency"
                    android:textAppearance="@style/TextAppearance.Chifaa.Caption"
                    android:textColor="@color/brand_plum" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        style="@style/Widget.Chifaa.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_l"
        android:onClick="enregistrer"
        android:text="@string/checkin_save"
        app:icon="@drawable/ic_check_circle"
        app:iconGravity="textStart" />
</LinearLayout>
