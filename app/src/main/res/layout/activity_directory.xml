<?xml version="1.0" encoding="utf-8"?>
<!-- Annuaire des services (module M6) : recherche par gouvernorat et par type. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:orientation="vertical"
    tools:context=".activities.DirectoryActivity">

    <include layout="@layout/layout_step_header" />

    <!-- Bandeau : données de démonstration -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_m"
        android:layout_marginTop="@dimen/space_s"
        android:layout_marginEnd="@dimen/space_m"
        android:background="@drawable/bg_warning_box"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_warning"
            app:tint="@color/state_warning" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/directory_demo"
            android:textColor="@color/state_warning"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Filtre : gouvernorat -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilGovernorate"
        style="@style/Widget.Chifaa.TextInput.Dropdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_m"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="@dimen/space_m"
        android:hint="@string/directory_governorate"
        app:startIconDrawable="@drawable/ic_place">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/acGovernorate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:saveEnabled="false" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Filtre : type de service -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:clipToPadding="false"
        android:paddingStart="@dimen/space_m"
        android:paddingEnd="@dimen/space_m"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipsTypes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tvCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="@dimen/space_xs"
        android:textAppearance="@style/TextAppearance.Chifaa.Caption"
        tools:text="5 service(s)" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvOrgs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/space_m"
            android:paddingTop="@dimen/space_s"
            android:paddingEnd="@dimen/space_m"
            android:paddingBottom="@dimen/space_l" />

        <!-- État vide : on propose d'élargir la recherche -->
        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/space_xl"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/brand_teal_soft">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_place"
                    app:tint="@color/brand_teal" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/directory_empty_title"
                android:textAppearance="@style/TextAppearance.Chifaa.Title" />

            <TextView
                android:id="@+id/tvEmptyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center"
                android:text="@string/directory_empty_text"
                android:textAppearance="@style/TextAppearance.Chifaa.Body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShowAll"
                style="@style/Widget.Chifaa.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:onClick="voirTousGouvernorats"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/directory_show_all" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
