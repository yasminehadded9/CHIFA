<?xml version="1.0" encoding="utf-8"?>
<!-- Écran partagé : inscription (étape 4) et connexion (mode "login"). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:orientation="vertical"
    tools:context=".activities.PhoneActivity">

    <include layout="@layout/layout_step_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_l">

            <!-- Numéro de téléphone (obligatoire) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPhone"
                style="@style/Widget.Chifaa.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/field_phone"
                app:counterEnabled="false"
                app:helperText="@string/helper_phone"
                app:prefixText="@string/phone_prefix"
                app:prefixTextColor="@color/text_secondary"
                app:startIconDrawable="@drawable/ic_phone">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPhone"
                    android:textDirection="ltr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="phoneNational"
                    android:digits="0123456789 "
                    android:imeOptions="actionDone"
                    android:inputType="phone"
                    android:maxLength="11"
                    android:textSize="17sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Surnom (facultatif, inscription uniquement) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDisplayName"
                style="@style/Widget.Chifaa.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:hint="@string/field_display_name"
                app:counterEnabled="true"
                app:counterMaxLength="30"
                app:helperText="@string/helper_display_name"
                app:startIconDrawable="@drawable/ic_person">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDisplayName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="30" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvRequiredLegend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/required_legend"
                android:textAppearance="@style/TextAppearance.Chifaa.Caption" />

            <!-- Information confidentialité -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:background="@drawable/bg_info_box"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/brand_raspberry" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/phone_privacy"
                    android:textAppearance="@style/TextAppearance.Chifaa.Caption"
                    android:textColor="@color/brand_plum" />
            </LinearLayout>

            <!-- Lien vers l'inscription (mode connexion uniquement) -->
            <LinearLayout
                android:id="@+id/rowNoAccount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_m"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_no_account"
                    android:textAppearance="@style/TextAppearance.Chifaa.Caption" />

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.Chifaa.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="allerInscription"
                    android:text="@string/login_create"
                    android:textColor="@color/brand_raspberry" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSendCode"
        style="@style/Widget.Chifaa.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_l"
        android:onClick="envoyerCode"
        android:text="@string/phone_send_code"
        app:icon="@drawable/ic_sms"
        app:iconGravity="textStart" />
</LinearLayout>
