<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Chifaa"
        tools:targetApi="34">

        <!-- Écran de démarrage : point d'entrée de l'application -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Chifaa.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Présentation de l'application (affichée une seule fois) -->
        <activity
            android:name=".activities.OnboardingActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Écran d'accueil : choix inscription / connexion / équipe -->
        <activity
            android:name=".activities.WelcomeActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Chifaa.Brand" />

        <!-- ===== Inscription (M1) ===== -->
        <activity
            android:name=".activities.SignupAgeActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".activities.ConsentActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".activities.SignupProfileActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- Téléphone et code SMS : inscription ET connexion -->
        <activity
            android:name=".activities.PhoneActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize|stateVisible" />
        <activity
            android:name=".activities.OtpActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize|stateVisible" />

        <!-- Espace connecté -->
        <activity
            android:name=".activities.ProfileActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.HomeActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Chifaa.Brand" />

        <!-- Espace santé (M3) -->
        <activity
            android:name=".activities.HealthActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".activities.JourneyActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.CheckinActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Bibliothèque (M4) -->
        <activity
            android:name=".activities.LibraryActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize|stateHidden" />
        <activity
            android:name=".activities.ArticleActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Annuaire (M6) -->
        <activity
            android:name=".activities.DirectoryActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".activities.OrgDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Compagnon (M5) -->
        <activity
            android:name=".activities.ChatActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize|stateHidden" />
        <activity
            android:name=".activities.ChatHistoryActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Mémorise la langue choisie (français/arabe) sur Android 12 et moins -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

    </application>

</manifest>
